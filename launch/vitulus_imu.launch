<launch>


<!--    #### BNO085Node publish imu and mag messages #####-->
    <!-- T39 2026-11-16: ovladac BNO085 ma dve provedeni se stejnym jmenem uzlu, tematy,
         parametry a kody ukonceni: python = nodes/bno085_node (vychozi, jako dosud),
         cpp = src/bno085_node.cpp (binarka bno085_node_cpp; mene CPU, rovnomernejsi perioda).
         Jina hodnota nez cpp = python.  cpp NENASAZENO, ceka na zkousku na skutecnem cidle.
         Prepinani na robotu: VITULUS_IMU_DRIVER=cpp v ~/.bashrc + restart stacku.
         ROLLBACK: promennou odebrat (vychozi python). -->
    <arg name="imu_driver" default="$(optenv VITULUS_IMU_DRIVER python)"/>
    <node unless="$(eval str(arg('imu_driver')) == 'cpp')"
          name="bno085_node" pkg="vitulus_imu" type="bno085_node" respawn="true"
          respawn_delay="1" output="log"/>
    <node if="$(eval str(arg('imu_driver')) == 'cpp')"
          name="bno085_node" pkg="vitulus_imu" type="bno085_node_cpp" respawn="true"
          respawn_delay="1" output="log"/>

    <!-- T36 2026-11-21: interval hlaseni cidla pro akcelerometr, gyroskop a game rotation
         vector [us]. 50000 (vychozi) = vsech 8 hlaseni po 20 Hz jako dosud, uzel se chova
         beze zmeny. 5000-49999 (napr. 10000 = 100 Hz): tato tri hlaseni rychleji, /bno085/imu
         pak nese jednu zpravu na kazdy novy vzorek (bez opakovani; kdyz game rotation vector
         prestane chodit, opakuje posledni jako dosud). Kdyz cidlo interval neprijme, uzel se
         sam vrati k 50000 a ohlasi to (log + bno085/health fast_report).
         NENASAZENO, ceka na zkousku v doku. Prepinani: VITULUS_IMU_FAST_REPORT_US=10000
         v ~/.bashrc + restart stacku (restart uzlu IMU = novy pocatek yaw).
         ROLLBACK: promennou odebrat (vychozi 50000). -->
    <arg name="imu_fast_report_interval_us" default="$(optenv VITULUS_IMU_FAST_REPORT_US 50000)"/>
    <param name="bno085_node/fast_report_interval_us" value="$(arg imu_fast_report_interval_us)"/>

<!--    #### Heading from the magnetometer (published and compared with RTK; navigation does not use it) #####-->
    <node name="mag_heading" pkg="vitulus_imu" type="mag_heading" respawn="true"
          respawn_delay="30" output="log">
        <param name="mag_topic" value="/bno085/mag_uncal"/>
        <param name="mag_source" value="uncal"/>
        <param name="imu_topic" value="/bno085/imu"/>
        <param name="rtk_topic" value="/gnss_heading/navheading"/>
        <param name="relpos_topic" value="/gnss_heading/navrelposned"/>
        <param name="motion_topic" value="/mobile_base_controller/odom"/>
        <param name="rtk_cov_min" value="0.00043"/>
        <param name="rtk_cov_max" value="0.00079"/>
        <param name="rtk_require_fixed" value="true"/>
        <!-- T35 I2 2026-11-16: sigma ve stavu ok podle chyby merene proti RTK kurzu
             (18 jizd: median sigmy 4,0 -> 2,2 deg, chyba pod 2 sigma v 99,6 %); jen
             kovariance vystupu, kurz sam se nemeni.
             ROLLBACK: sigma_from_rtk:=false (sigma jako drive, zaklad sigma_ok_deg 4 deg). -->
        <param name="sigma_from_rtk" value="true"/>
        <param name="fuse_tau_s" value="60.0"/>
        <param name="freeze_standing" value="true"/>
        <param name="calibration_file" value="$(env HOME)/.ros/vitulus_imu/mag_calibration.yaml"/>
        <param name="self_calibrate" value="true"/>
        <param name="fit_interval_s" value="45.0"/>
        <!-- T35 I3 2026-11-16: vzorek samokalibrace se zaradi, az kdyz RTK kurz zustal
             platny jeste 10 s po nem (pred ztratou RTK u garaze je kurz mimo; 18 jizd:
             ze 131 vzorku zahazovanych pri zpresneni jich 115 vubec nevznikne).
             ROLLBACK: sample_confirm_s:=0 (vzorky se berou hned jako drive). -->
        <param name="sample_confirm_s" value="10.0"/>
    </node>


<!--##### Show in Rviz #####-->
<!--    <node name="rviz"-->
<!--              pkg="rviz"-->
<!--              type="rviz"-->
<!--              args="-d $(find vitulus_imu)/rviz/imu.rviz"-->
<!--              required="false" />-->



</launch>
