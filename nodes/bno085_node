#!/usr/bin/env python
"""BNO085 over UART: publishes /bno085/imu, /navheading, /mag, /mag_uncal, and watches itself.

The sensor is opened through adafruit_bno08x, whose UART code reads for ever when
the port has no timeout and loops for ever in soft_reset() when the sensor does
not answer.  This node therefore:

  * opens the port with a read timeout and flushes it (GuardedUart);
  * bounds the reset handshake, repeats the request, tolerates a broken first
    frame (BoundedBNO); two attempts with a reopen, then a non-zero exit so
    that the roslaunch respawn starts over;
  * survives a damaged frame at runtime without resetting the sensor: a reset
    restarts the game rotation vector, so yaw jumps;
  * stops publishing frozen values when packets stop, and exits after
    ~stall_timeout_s;
  * has a daemon thread (Supervisor) that ends the process with os._exit when
    the main thread is stuck or does not obey a shutdown.

Consecutive failures live in ~failures (parameter server, survives the respawn):
pause before a new try 0, 1, 2, 4 ... ~backoff_max_s seconds.  From
~max_failures the state reads `failed`, tries go on at the slowest pace.

~stamp_at_read (default false = header.stamp is the time of publishing, as
always): true stamps a message with the time its report was read from the
port: the game rotation vector for bno085/imu, the rotation vector for
bno085/navheading, report 0x03 for bno085/mag, 0x0F for bno085/mag_uncal.  The
100 Hz messages that repeat a sample then repeat its stamp too.  The port is
read once per 100 Hz cycle, so the stamp is up to 10 ms after the arrival.
TURN IT ON ONLY TOGETHER WITH A FAST REPORT INTERVAL (~fast_report_interval_us
under 50000): with the 20 Hz reports the stamps of bno085/imu stand still for
40-65 ms, and navi_transform (heading_imu_interp) drops an RTK heading sample
whose neighbouring IMU stamps are more than 50 ms away.  The node warns once
at the start when it is on without a fast interval.

  out bno085/imu_status  vitulus_msgs/Imu_status, 1 Hz, also during startup;
                         status true only while fresh packets arrive
      bno085/health      std_msgs/String JSON, latched, 1 Hz:
                         state backoff|connecting|ok|stalled|failed
                         reason, failures, attempt, packet_age_s, frame_errors,
                         sensor_reset_t (wall time of the last sensor reset: a
                         new value means a new yaw origin), pid,
                         mag_accuracy (0-3, BNO calibration accuracy of the
                         calibrated magnetometer report 0x03),
                         mag_uncal (on|no data|unavailable|off; 'no data'
                         also when 0x0F stops for ~mag_uncal_stale_s),
                         mag_uncal_accuracy, mag_bias_uT (BNO's own hard-iron
                         estimate from report 0x0F)
      bno085/mag_uncal   sensor_msgs/MagneticField (tesla), report 0x0F
                         "magnetic field uncalibrated": not touched by the BNO
                         dynamic calibration; published per new report (~20 Hz)

Report 0x0F is optional: when the sensor does not enable it, the node runs on
without it and logs one warning.  The BNO dynamic calibration is left as it is.

~fast_report_interval_us (default 50000 = every report at 20 Hz, as always):
a smaller value (5000-49999) asks the sensor for the accelerometer, the
gyroscope and the game rotation vector at that interval; the other reports
stay at 50000.  /bno085/imu then carries one message per new game rotation
vector (no repeated samples; the 100 Hz loop is the upper limit), the other
topics stay as they are.  When no game rotation vector comes for 0.05 s while
other reports do, /bno085/imu goes on as with the default: a message every
cycle with the last orientation (one warning per 30 s).  When the sensor does not answer such a request, or
answers with no faster interval, all three go back to 50000 and the node runs
as with the default (one warning).  Only with a non-default value the health
gets two more keys: fast_report (pending|on|fallback) and
fast_report_interval_us (the slowest interval the sensor granted).
  exit 0 shutdown, 1 connect failed, 2 packets stopped, 3 port lost, 4 hard exit
"""
import json
import logging
import os
import struct
import sys
import threading
import time

import rospy
from sensor_msgs.msg import MagneticField, Imu
from std_msgs.msg import String
from vitulus_msgs.msg import Imu_status
import serial
import adafruit_bno08x
from adafruit_bno08x import PacketError, _separate_batch
from adafruit_bno08x.uart import BNO08X_UART

CHANNEL_SHTP_COMMAND = 0
CHANNEL_EXE = 1
CHANNEL_SENSOR_REPORTS = 3
BNO_REPORT_MAG_UNCAL = 0x0F
MAG_UNCAL_LEN = 16
Q4 = 2.0 ** -4
EXIT_OK, EXIT_CONNECT, EXIT_STALL, EXIT_PORT, EXIT_HARD = 0, 1, 2, 3, 4
CHANNEL_CONTROL = 2
GET_FEATURE_RESPONSE = 0xFC
FEATURE_ENABLE_TIMEOUT = 2.0
DEFAULT_REPORT_INTERVAL_US = 50000       # the library default
FAST_REPORT_MIN_US = 5000
FAST_REPEAT_AFTER_S = 0.05               # no new game rotation vector for so long: repeat the last one
FAST_REPORTS = (adafruit_bno08x.BNO_REPORT_ACCELEROMETER, adafruit_bno08x.BNO_REPORT_GYROSCOPE,
                adafruit_bno08x.BNO_REPORT_GAME_ROTATION_VECTOR)
SHTP_ADVERTISE_RESEND_S = 1.0


def parse_mag_uncal(report):
    """SH-2 report 0x0F, 16 bytes: id, seq, status (accuracy in bits 1:0), delay,
    X Y Z uncalibrated, X Y Z hard-iron bias; int16 little endian, Q4 microtesla.
    Returns ((x, y, z) uT, (bx, by, bz) uT, accuracy)."""
    if len(report) < MAG_UNCAL_LEN or report[0] != BNO_REPORT_MAG_UNCAL:
        raise ValueError('not a 0x0F report: %r' % bytes(report[:2]))
    v = struct.unpack_from('<6h', bytes(report), 4)
    return tuple(x * Q4 for x in v[:3]), tuple(x * Q4 for x in v[3:]), report[2] & 0x03


def register_mag_uncal():
    """Teach the library the length of report 0x0F (its batch splitter needs it).
    False when this library version has no such table."""
    try:
        reports = adafruit_bno08x._AVAIL_SENSOR_REPORTS
        reports.setdefault(BNO_REPORT_MAG_UNCAL, (Q4, 3, MAG_UNCAL_LEN))
        return reports[BNO_REPORT_MAG_UNCAL][2] == MAG_UNCAL_LEN
    except Exception:  # noqa: BLE001
        return False


MAG_UNCAL_SUPPORTED = register_mag_uncal()


class UartSilent(Exception):
    """Nothing arrived within the read timeout."""


class ShutdownRequested(Exception):
    """rospy is shutting down while we wait for the sensor."""


class ImuInitError(Exception):
    """The sensor did not complete the reset handshake."""


class GuardedUart(object):
    """A serial port for the library: read() returns data or raises, never blocks
    for long.  The library's own loop `if not data: continue` would otherwise spin
    for ever on a silent port."""

    def __init__(self, port, baudrate, read_timeout, should_stop):
        self.should_stop = should_stop
        self.ser = serial.Serial(port, baudrate=baudrate, timeout=read_timeout,
                                 write_timeout=read_timeout, exclusive=True)
        self.ser.reset_input_buffer()
        self.ser.reset_output_buffer()

    def read(self, size=1):
        data = self.ser.read(size)
        if not data:
            if self.should_stop():
                raise ShutdownRequested()
            raise UartSilent()
        return data

    def write(self, data):
        return self.ser.write(data)

    @property
    def in_waiting(self):
        return self.ser.in_waiting

    def close(self):
        try:
            self.ser.close()
        except (serial.SerialException, OSError):
            pass


class BoundedBNO(BNO08X_UART):
    """BNO08X_UART with a time limit on everything in initialize()."""

    stamp_at_read = False                # ~stamp_at_read, set by the node
    packet_stamp = None                  # ROS time the packet being handled was read at
    report_stamp = None                  # report id -> packet_stamp of its last report

    def stamp(self, report_id):
        """header.stamp for a message made of this report."""
        if self.stamp_at_read and self.report_stamp and self.report_stamp.get(report_id) is not None:
            return self.report_stamp[report_id]
        return rospy.Time.now()

    def __init__(self, uart, advert_timeout, should_stop):
        self.advert_timeout = advert_timeout
        self.should_stop = should_stop
        self.last_report_t = None
        self.frame_errors = 0
        self.mag_uncal = None            # (x, y, z) uT
        self.mag_bias = None             # (x, y, z) uT
        self.mag_uncal_accuracy = None
        self.mag_uncal_count = 0
        self._uncal_in_packet = False
        self.game_count = 0              # game rotation vector reports taken
        self.feature_interval = {}       # feature id -> interval of its last feature response [us]
        super().__init__(uart, reset=None, debug=False)

    def initialize(self):
        # One try only: the caller reopens the port between tries.
        self.soft_reset()
        self._check_id()

    def soft_reset(self):
        deadline = time.monotonic() + self.advert_timeout
        resend_t = 0.0
        while True:
            if self.should_stop():
                raise ShutdownRequested()
            now = time.monotonic()
            if now >= deadline:
                raise ImuInitError('no SHTP answer in %.1f s' % self.advert_timeout)
            if now >= resend_t:
                self._send_packet(CHANNEL_SHTP_COMMAND, bytearray([0, 1]))
                resend_t = time.monotonic() + SHTP_ADVERTISE_RESEND_S
                time.sleep(0.5)
            try:
                packet = self._read_packet()
            except UartSilent:
                continue
            except (RuntimeError, PacketError, IndexError):
                # We joined the stream in the middle of a frame.
                self.frame_errors += 1
                continue
            if packet.channel_number == CHANNEL_SHTP_COMMAND:
                break
        self._send_packet(CHANNEL_EXE, bytearray([1]))
        time.sleep(0.5)
        self._send_packet(CHANNEL_EXE, bytearray([1]))
        time.sleep(0.5)

    def _read_packet(self):
        packet = super()._read_packet()
        if packet.channel_number == CHANNEL_SENSOR_REPORTS:
            self.last_report_t = time.monotonic()
            if self.stamp_at_read:
                self.packet_stamp = rospy.Time.now()
        return packet

    def _handle_packet(self, packet):
        # As the library, without print(packet) on each damaged packet.
        self._uncal_in_packet = False
        try:
            _separate_batch(packet, self._packet_slices)
            while self._packet_slices:
                report_id, report_bytes = self._packet_slices.pop()
                self._process_report(report_id, report_bytes)
                if self.stamp_at_read:
                    if self.report_stamp is None:
                        self.report_stamp = {}
                    if report_id == 0xFC:        # feature response: the reading is zeros again
                        self.report_stamp.pop(report_bytes[1], None)
                    else:
                        self.report_stamp[report_id] = self.packet_stamp
        finally:
            del self._packet_slices[:]

    def _process_report(self, report_id, report_bytes):
        if report_id != BNO_REPORT_MAG_UNCAL:
            out = super()._process_report(report_id, report_bytes)
            if report_id == adafruit_bno08x.BNO_REPORT_GAME_ROTATION_VECTOR:
                self.game_count += 1
            return out
        # Reports of a batch come newest first (pop from the end): keep the first.
        if self._uncal_in_packet:
            return None
        self._uncal_in_packet = True
        self.mag_uncal, self.mag_bias, self.mag_uncal_accuracy = parse_mag_uncal(report_bytes)
        self.mag_uncal_count += 1
        return None

    def poll(self):
        self._process_available_packets(max_packets=200)

    def report_age(self):
        if self.last_report_t is None:
            return None
        return time.monotonic() - self.last_report_t

    def _handle_control_report(self, report_id, report_bytes):
        super()._handle_control_report(report_id, report_bytes)
        if report_id == GET_FEATURE_RESPONSE:
            self.feature_interval[report_bytes[1]] = struct.unpack_from('<I', bytes(report_bytes), 5)[0]

    def enable_feature_at(self, feature_id, interval_us):
        """enable_feature of the library with another report interval.  Waits for
        the feature response and returns the interval the sensor took [us]."""
        report = self._get_feature_enable_report(feature_id, interval_us)
        self.feature_interval.pop(feature_id, None)
        self._send_packet(CHANNEL_CONTROL, report)
        start = time.monotonic()
        while time.monotonic() - start < FEATURE_ENABLE_TIMEOUT:
            self._process_available_packets(max_packets=10)
            if feature_id in self.feature_interval:
                return self.feature_interval[feature_id]
            if not self._data_ready:
                time.sleep(0.0005)
        raise RuntimeError("Was not able to enable feature", feature_id)


class Supervisor(threading.Thread):
    """Ends the process when the main thread cannot.  on_tick runs about 1x/s."""

    PERIOD_S = 0.2

    def __init__(self, is_shutdown, on_tick, log, shutdown_grace_s=2.0):
        super().__init__(name='bno085_supervisor', daemon=True)
        self.is_shutdown = is_shutdown
        self.on_tick = on_tick
        self.log = log
        self.shutdown_grace_s = shutdown_grace_s
        self.beat_t = time.monotonic()
        self.limit_s = 60.0
        self.exit_t = None
        self.exit_code = EXIT_OK

    def beat(self, limit_s):
        self.limit_s = limit_s
        self.beat_t = time.monotonic()

    def leave_within(self, seconds, code):
        self.exit_code = code
        self.exit_t = time.monotonic() + seconds

    def hard_exit(self, code, why):
        self.log(why)
        logging.shutdown()
        os._exit(code)

    def run(self):
        last = time.monotonic()
        tick_t = 0.0
        while True:
            time.sleep(self.PERIOD_S)
            now = time.monotonic()
            # We stalled too (memory pressure, CPU): the main thread gets a new
            # chance, otherwise a machine hiccup would reset the sensor.
            if now - last > 1.0:
                self.beat_t += now - last
            last = now
            if self.exit_t is None and self.is_shutdown():
                self.leave_within(self.shutdown_grace_s, EXIT_OK)
            if self.exit_t is not None:
                if now >= self.exit_t:
                    self.hard_exit(self.exit_code, 'bno085_node: forced exit %d' % self.exit_code)
            elif now - self.beat_t > self.limit_s:
                self.hard_exit(EXIT_HARD, 'bno085_node: main thread stuck for %.0f s, hard exit'
                               % (now - self.beat_t))
            if now - tick_t >= 1.0:
                tick_t = now
                try:
                    self.on_tick()
                except Exception:  # noqa: BLE001 - must never stop the watchdog
                    pass


class BNO085Node:

    def __init__(self):
        self.port = rospy.get_param('~port', '/dev/imu')
        BoundedBNO.stamp_at_read = self.read_switch('~stamp_at_read')
        if BoundedBNO.stamp_at_read and not self.fast_interval_asked():
            rospy.logwarn("<{}> stamp_at_read without a fast report interval: messages that repeat a "
                          "sample repeat its stamp (40-65 ms apart), navi_transform then drops part of "
                          "the RTK heading samples; turn it on together with "
                          "fast_report_interval_us".format(rospy.get_caller_id()))
        self.baud = rospy.get_param('~baud', 3000000)
        self.read_timeout_s = rospy.get_param('~read_timeout_s', 0.2)
        self.advert_timeout_s = rospy.get_param('~advert_timeout_s', 3.0)
        self.connect_attempts = rospy.get_param('~connect_attempts', 2)
        self.init_limit_s = rospy.get_param('~init_limit_s', 40.0)
        self.run_limit_s = rospy.get_param('~run_limit_s', 5.0)
        self.stale_s = rospy.get_param('~stale_s', 0.5)
        self.stall_timeout_s = rospy.get_param('~stall_timeout_s', 2.0)
        self.stable_s = rospy.get_param('~stable_s', 10.0)
        self.backoff_max_s = rospy.get_param('~backoff_max_s', 30.0)
        self.max_failures = rospy.get_param('~max_failures', 8)
        self.want_mag_uncal = rospy.get_param('~mag_uncal', True)
        self.mag_uncal_warn_s = rospy.get_param('~mag_uncal_warn_s', 5.0)
        self.mag_uncal_stale_s = rospy.get_param('~mag_uncal_stale_s', 2.0)
        self.failures = rospy.get_param('~failures', 0)
        self.fast_interval_us = self.read_fast_interval()
        self.fast_state = 'pending'      # pending | on | fallback (used only with a non-default interval)
        self.fast_granted_us = DEFAULT_REPORT_INTERVAL_US
        self.imu_sent = 0
        self.imu_new_t = 0.0

        self.imu_pub = rospy.Publisher('bno085/imu', Imu, queue_size=10)
        self.nevheading_pub = rospy.Publisher('bno085/navheading', Imu, queue_size=10)
        self.mag_pub = rospy.Publisher('bno085/mag', MagneticField, queue_size=10)
        self.mag_uncal_pub = rospy.Publisher('bno085/mag_uncal', MagneticField, queue_size=10)
        self.imu_status_pub = rospy.Publisher('bno085/imu_status', Imu_status, queue_size=10)
        self.health_pub = rospy.Publisher('bno085/health', String, queue_size=1, latch=True)
        self.msg_bno085_status = Imu_status()
        self.msg_bno085_status.status = False

        self.uart = None
        self.bno = None
        self.state = 'connecting'
        self.reason = ''
        self.attempt = 0
        self.sensor_reset_t = 0.0
        self.mag_uncal_state = 'off'     # on | no data | unavailable | off
        self.mag_uncal_warned = False
        self.mag_uncal_sent = 0
        self.mag_uncal_enabled_t = 0.0
        self.mag_uncal_last_t = 0.0
        self.supervisor = Supervisor(rospy.is_shutdown, self.publish_status, self.log_hard)
        self.supervisor.start()

    @staticmethod
    def log_hard(text):
        rospy.logerr(text)

    @staticmethod
    def read_fast_interval():
        """~fast_report_interval_us as an interval the node may ask for; anything
        else is the default."""
        raw = rospy.get_param('~fast_report_interval_us', DEFAULT_REPORT_INTERVAL_US)
        try:
            value = int(float(raw))
        except (TypeError, ValueError, OverflowError):
            value = -1
        if value == DEFAULT_REPORT_INTERVAL_US:
            return value
        if not FAST_REPORT_MIN_US <= value < DEFAULT_REPORT_INTERVAL_US:
            rospy.logwarn("<{}> fast_report_interval_us {!r} is not within {}-{}, using {}".format(
                rospy.get_caller_id(), raw, FAST_REPORT_MIN_US, DEFAULT_REPORT_INTERVAL_US,
                DEFAULT_REPORT_INTERVAL_US))
            return DEFAULT_REPORT_INTERVAL_US
        return value

    def backoff_s(self):
        if self.failures <= 1:
            return 0.0
        return min(2.0 ** (self.failures - 2), self.backoff_max_s)

    @staticmethod
    def read_switch(name):
        """A parameter that is off unless it clearly says on: true, a number but
        0, or the text true / 1 / yes / on."""
        raw = rospy.get_param(name, False)
        if isinstance(raw, str):
            return raw.strip().lower() in ('true', '1', 'yes', 'on')
        return isinstance(raw, (bool, int, float)) and bool(raw)

    @staticmethod
    def fast_interval_asked():
        """~fast_report_interval_us asks for reports faster than the default."""
        try:
            return 5000 <= int(float(rospy.get_param('~fast_report_interval_us', 50000))) < 50000
        except (TypeError, ValueError, OverflowError):
            return False

    def set_state(self, state, reason=''):
        self.state, self.reason = state, reason
        self.publish_status()

    def publish_status(self):
        age = self.bno.report_age() if self.bno is not None else None
        fresh = self.state == 'ok' and age is not None and age <= self.stale_s
        bno = self.bno
        self.msg_bno085_status.status = fresh
        self.msg_bno085_status.header.stamp = rospy.Time.now()
        self.imu_status_pub.publish(self.msg_bno085_status)
        extra = {}
        if self.fast_interval_us != DEFAULT_REPORT_INTERVAL_US:
            extra = {'fast_report': self.fast_state, 'fast_report_interval_us': self.fast_granted_us}
        self.health_pub.publish(String(json.dumps(dict({
            'state': self.state, 'reason': self.reason, 'ok': fresh,
            'failures': self.failures, 'attempt': self.attempt,
            'packet_age_s': None if age is None else round(age, 2),
            'frame_errors': self.bno.frame_errors if self.bno is not None else 0,
            'sensor_reset_t': self.sensor_reset_t, 'pid': os.getpid(),
            'mag_accuracy': getattr(bno, '_magnetometer_accuracy', None) if bno is not None else None,
            'mag_uncal': self.mag_uncal_state,
            'mag_uncal_accuracy': bno.mag_uncal_accuracy if bno is not None else None,
            'mag_bias_uT': [round(v, 2) for v in bno.mag_bias]
            if bno is not None and bno.mag_bias is not None else None}, **extra))))

    def wait(self, seconds):
        """A pause that a shutdown ends at once."""
        end = time.monotonic() + seconds
        while time.monotonic() < end and not rospy.is_shutdown():
            self.supervisor.beat(self.init_limit_s)
            time.sleep(0.1)

    def close_uart(self):
        if self.uart is not None:
            self.uart.close()
            self.uart = None

    def connect_once(self):
        rospy.loginfo("<{}> Connecting UART {}, baudrate {}...".format(
            rospy.get_caller_id(), self.port, self.baud))
        self.uart = GuardedUart(self.port, self.baud, self.read_timeout_s, rospy.is_shutdown)
        self.bno = BoundedBNO(self.uart, self.advert_timeout_s, rospy.is_shutdown)
        self.imu_sent = 0
        self.imu_new_t = time.monotonic()
        self.fast_done = []
        self.fast_granted_us = DEFAULT_REPORT_INTERVAL_US
        self.fast_state = 'pending'
        if self.fast_interval_us != DEFAULT_REPORT_INTERVAL_US:
            self.fast_state = 'on'
        for feature in (adafruit_bno08x.BNO_REPORT_ACCELEROMETER,
                        adafruit_bno08x.BNO_REPORT_GYROSCOPE,
                        adafruit_bno08x.BNO_REPORT_MAGNETOMETER,
                        adafruit_bno08x.BNO_REPORT_ROTATION_VECTOR,
                        adafruit_bno08x.BNO_REPORT_LINEAR_ACCELERATION,
                        adafruit_bno08x.BNO_REPORT_GEOMAGNETIC_ROTATION_VECTOR,
                        adafruit_bno08x.BNO_REPORT_GAME_ROTATION_VECTOR):
            if self.fast_state == 'on' and feature in FAST_REPORTS:
                self.enable_fast(feature)
            else:
                self.bno.enable_feature(feature)
            self.supervisor.beat(self.init_limit_s)
        self.sensor_reset_t = time.time()
        self.enable_mag_uncal()
        rospy.loginfo("<{}> UART connected.".format(rospy.get_caller_id()))

    def enable_fast(self, feature):
        """One of FAST_REPORTS at ~fast_report_interval_us.  When the sensor does
        not take it, this report and the ones before it go back to the default
        interval and the node runs as without the parameter."""
        why = None
        try:
            granted = self.bno.enable_feature_at(feature, self.fast_interval_us)
            if not 0 < granted < DEFAULT_REPORT_INTERVAL_US:
                why = 'the sensor answered %d us' % granted
        except RuntimeError:
            why = 'no answer'
        if why is None:
            self.fast_done.append(feature)
            self.fast_granted_us = max([self.bno.feature_interval[f] for f in self.fast_done])
            return
        self.fast_state = 'fallback'
        self.fast_granted_us = DEFAULT_REPORT_INTERVAL_US
        rospy.logwarn("<{}> report {} at {} us not enabled ({}), back to {} us for all reports".format(
            rospy.get_caller_id(), feature, self.fast_interval_us, why, DEFAULT_REPORT_INTERVAL_US))
        for done in self.fast_done + [feature]:
            self.bno.enable_feature(done)
            self.supervisor.beat(self.init_limit_s)

    def warn_mag_uncal(self, text):
        if not self.mag_uncal_warned:
            self.mag_uncal_warned = True
            rospy.logwarn("<{}> {}".format(rospy.get_caller_id(), text))

    def enable_mag_uncal(self):
        """Report 0x0F, optional: a refusal costs ~2 s per try, never the connection."""
        if not self.want_mag_uncal:
            self.mag_uncal_state = 'off'
            return
        if not MAG_UNCAL_SUPPORTED:
            self.mag_uncal_state = 'unavailable'
            self.warn_mag_uncal('magnetometer report 0x0F not supported by this adafruit_bno08x, '
                                '/bno085/mag_uncal off')
            return
        error = None
        self.mag_uncal_sent = 0
        for _ in range(2):
            try:
                self.bno.enable_feature(BNO_REPORT_MAG_UNCAL)
                self.mag_uncal_state = 'no data'
                self.mag_uncal_enabled_t = time.monotonic()
                return
            except (RuntimeError, PacketError, IndexError, KeyError, ValueError, struct.error) as exc:
                error = exc
            finally:
                self.supervisor.beat(self.init_limit_s)
        self.mag_uncal_state = 'unavailable'
        self.warn_mag_uncal('magnetometer report 0x0F not enabled ({}), /bno085/mag_uncal off'.format(error))

    def connect(self):
        """True when the sensor streams; False after the tries or at a shutdown."""
        pause = self.backoff_s()
        if pause > 0:
            state = 'failed' if self.failures >= self.max_failures else 'backoff'
            self.set_state(state, 'waiting %.0f s, %d failures' % (pause, self.failures))
            self.wait(pause)
        for self.attempt in range(1, self.connect_attempts + 1):
            if rospy.is_shutdown():
                return False
            self.set_state('connecting')
            self.supervisor.beat(self.init_limit_s)
            try:
                self.connect_once()
                self.set_state('ok')
                return True
            except ShutdownRequested:
                return False
            except (ImuInitError, UartSilent, RuntimeError, PacketError, IndexError,
                    serial.SerialException, OSError) as exc:
                self.reason = '{}: {}'.format(type(exc).__name__, exc)
                rospy.logwarn("<{}> connect try {}/{} failed: {}".format(
                    rospy.get_caller_id(), self.attempt, self.connect_attempts, self.reason))
            self.bno = None
            self.close_uart()
            self.wait(0.3)
        return False

    def note_failure(self, state, reason):
        self.failures += 1
        try:
            rospy.set_param('~failures', self.failures)
        except Exception:  # noqa: BLE001 - only the pause gets shorter
            pass
        if self.failures >= self.max_failures:
            state = 'failed'
        if self.failures == self.max_failures:
            rospy.logerr("<{}> IMU failed {} times in a row: {}".format(
                rospy.get_caller_id(), self.failures, reason))
        else:
            rospy.logwarn("<{}> IMU {}: {} (failure {})".format(
                rospy.get_caller_id(), state, reason, self.failures))
        self.set_state(state, reason)

    def clear_failures(self):
        self.failures = 0
        try:
            rospy.set_param('~failures', 0)
        except Exception:  # noqa: BLE001
            pass

    def spin(self):
        """Returns the exit code."""
        rate = 100
        r = rospy.Rate(rate)  # 100Hz
        rospy.loginfo("<{}> Initialised.".format(rospy.get_caller_id()))
        started = time.monotonic()
        last_errors = 0
        while not rospy.is_shutdown():
            self.supervisor.beat(self.run_limit_s)
            try:
                self.bno.poll()
                age = self.bno.report_age()
                if age is not None and age <= self.stale_s:
                    self.publish_mag()
                    self.publish_imu()
                    self.publish_imu_heading()
                    try:
                        self.publish_mag_uncal()
                    except (serial.SerialException, OSError, rospy.ROSException):
                        raise
                    except Exception as exc:  # noqa: BLE001 - optional topic, never stops the IMU
                        rospy.logwarn_throttle(60.0, "<{}> mag_uncal: {!r}".format(
                            rospy.get_caller_id(), exc))
            except (serial.SerialException, OSError) as exc:
                self.note_failure('stalled', 'port lost: {}'.format(exc))
                return EXIT_PORT
            except rospy.ROSException:
                if rospy.is_shutdown():
                    break
            except Exception:  # noqa: BLE001 - damaged frame: resync, keep the yaw origin
                self.bno.frame_errors += 1

            age = self.bno.report_age()
            if age is None:
                age = time.monotonic() - started
            if age > self.stall_timeout_s:
                self.note_failure('stalled', 'no sensor packets for %.1f s' % age)
                return EXIT_STALL
            if self.failures and time.monotonic() - started > self.stable_s:
                self.clear_failures()
            if self.bno.frame_errors != last_errors:
                last_errors = self.bno.frame_errors
                rospy.logwarn_throttle(30.0, "<{}> {} damaged frames so far, resynced".format(
                    rospy.get_caller_id(), last_errors))
            try:
                r.sleep()
            except rospy.ROSTimeMovedBackwardsException:
                pass
            except rospy.ROSInterruptException:
                break
        return EXIT_OK

    def run(self):
        code = EXIT_OK
        if self.connect():
            code = self.spin()
        elif not rospy.is_shutdown():
            self.note_failure('connecting', self.reason or 'no sensor')
            code = EXIT_CONNECT
        self.supervisor.leave_within(2.0, code)
        self.close_uart()
        return code

    def publish_imu(self):
        acc_x, acc_y, acc_z = self.bno.acceleration
        gyro_x, gyro_y, gyro_z = self.bno.gyro
        # orientation_x, orientation_y, orientation_z, orientation_w = self.bno.quaternion
        # orientation_x, orientation_y, orientation_z, orientation_w = self.bno.geomagnetic_quaternion
        orientation_x, orientation_y, orientation_z, orientation_w = self.bno.game_quaternion
        imu_msg = Imu()
        imu_msg.header.stamp = self.bno.stamp(adafruit_bno08x.BNO_REPORT_GAME_ROTATION_VECTOR)
        imu_msg.header.frame_id = "bno_imu_link"
        imu_msg.orientation.x = orientation_x
        imu_msg.orientation.y = orientation_y
        imu_msg.orientation.z = orientation_z
        imu_msg.orientation.w = orientation_w
        imu_msg.orientation_covariance = [0.025, 0.0, 0.0, 0.0, 0.025, 0.0, 0.0, 0.0, 0.025]
        imu_msg.angular_velocity.x = gyro_x
        imu_msg.angular_velocity.y = gyro_y
        imu_msg.angular_velocity.z = gyro_z
        imu_msg.angular_velocity_covariance = [0.025, 0.0, 0.0, 0.0, 0.025, 0.0, 0.0, 0.0, 0.025]
        imu_msg.linear_acceleration.x = acc_x
        imu_msg.linear_acceleration.y = acc_y
        imu_msg.linear_acceleration.z = acc_z
        imu_msg.linear_acceleration_covariance = [0.025, 0.0, 0.0, 0.0, 0.025, 0.0, 0.0, 0.0, 0.025]
        if self.fast_state == 'on':      # one message per new game rotation vector
            now = time.monotonic()
            if self.bno.game_count != self.imu_sent:
                self.imu_sent = self.bno.game_count
                self.imu_new_t = now
            elif now - self.imu_new_t <= FAST_REPEAT_AFTER_S:
                return
            else:                        # the report stopped: go on as with the default interval
                rospy.logwarn_throttle(30.0, "<{}> no game rotation vector for {:.2f} s, /bno085/imu "
                                       "repeats the last orientation".format(
                                           rospy.get_caller_id(), now - self.imu_new_t))
        if ((orientation_x + orientation_y + orientation_z + orientation_w) != 0.0):
            self.imu_pub.publish(imu_msg)

    def publish_mag(self):
        mag_x, mag_y, mag_z = self.bno.magnetic
        mag_msg = MagneticField()
        mag_msg.header.stamp = self.bno.stamp(adafruit_bno08x.BNO_REPORT_MAGNETOMETER)
        mag_msg.header.frame_id = "bno_imu_link"
        mag_msg.magnetic_field.x = mag_x * 0.000001
        mag_msg.magnetic_field.y = mag_y * 0.000001
        mag_msg.magnetic_field.z = mag_z * 0.000001
        mag_msg.magnetic_field_covariance = [0.025, 0.0, 0.0, 0.0, 0.025, 0.0, 0.0, 0.0, 0.025]
        self.mag_pub.publish(mag_msg)

    def publish_mag_uncal(self):
        bno = self.bno
        if self.mag_uncal_state not in ('on', 'no data'):
            return
        now = time.monotonic()
        if bno.mag_uncal_count == self.mag_uncal_sent:
            if self.mag_uncal_state == 'on' and now - self.mag_uncal_last_t > self.mag_uncal_stale_s:
                self.mag_uncal_state = 'no data'       # 0x0F stopped while the rest streams
                self.mag_uncal_enabled_t = now
            elif self.mag_uncal_state == 'no data' and now - self.mag_uncal_enabled_t > self.mag_uncal_warn_s:
                self.warn_mag_uncal('magnetometer report 0x0F enabled but no data for %.0f s'
                                    % self.mag_uncal_warn_s)
            return
        self.mag_uncal_sent = bno.mag_uncal_count
        self.mag_uncal_last_t = now
        self.mag_uncal_state = 'on'
        x, y, z = bno.mag_uncal
        msg = MagneticField()
        msg.header.stamp = bno.stamp(BNO_REPORT_MAG_UNCAL)
        msg.header.frame_id = "bno_imu_link"
        msg.magnetic_field.x = x * 0.000001
        msg.magnetic_field.y = y * 0.000001
        msg.magnetic_field.z = z * 0.000001
        msg.magnetic_field_covariance = [0.025, 0.0, 0.0, 0.0, 0.025, 0.0, 0.0, 0.0, 0.025]
        self.mag_uncal_pub.publish(msg)

    def publish_imu_heading(self):
        acc_x, acc_y, acc_z = self.bno.acceleration
        gyro_x, gyro_y, gyro_z = self.bno.gyro
        orientation_x, orientation_y, orientation_z, orientation_w = self.bno.quaternion
        imu_msg = Imu()
        imu_msg.header.stamp = self.bno.stamp(adafruit_bno08x.BNO_REPORT_ROTATION_VECTOR)
        imu_msg.header.frame_id = "bno_imu_link"
        imu_msg.orientation.x = orientation_x
        imu_msg.orientation.y = orientation_y
        imu_msg.orientation.z = orientation_z
        imu_msg.orientation.w = orientation_w
        imu_msg.orientation_covariance = [0.025, 0.0, 0.0, 0.0, 0.025, 0.0, 0.0, 0.0, 0.025]
        imu_msg.angular_velocity.x = gyro_x
        imu_msg.angular_velocity.y = gyro_y
        imu_msg.angular_velocity.z = gyro_z
        imu_msg.angular_velocity_covariance = [0.025, 0.0, 0.0, 0.0, 0.025, 0.0, 0.0, 0.0, 0.025]
        imu_msg.linear_acceleration.x = acc_x
        imu_msg.linear_acceleration.y = acc_y
        imu_msg.linear_acceleration.z = acc_z
        imu_msg.linear_acceleration_covariance = [1000.00, 0.0, 0.0, 0.0, 1000.00, 0.0, 0.0, 0.0, 1000.00]
        if ((orientation_x + orientation_y + orientation_z + orientation_w) != 0.0):
            self.nevheading_pub.publish(imu_msg)

if __name__ == '__main__':
    rospy.init_node('bno085_node')
    rospy.loginfo("<{}> Initialising bno085_node...".format(rospy.get_caller_id()))
    sys.exit(BNO085Node().run())
